# Node modules
node_modules/

# Build output
dist/
.vitepress/dist/ # If using VitePress

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.*.local # Local environment variables (e.g., .env.development.local)

# Editor and OS generated files
.DS_Store
Thumbs.db
.vscode/ # VS Code settings, if not shared globally
.idea/ # IntelliJ IDEA settings
*.sublime-project
*.sublime-workspace

# Dependency lock files (if you prefer to ignore them)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Other temporary files
temp/
tmp/